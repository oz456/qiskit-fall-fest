# ---- Required in production (store secrets in GCP Secret Manager, never in git) ----
NODE_ENV=production
PORT=8080
# Neon pooled connection string (sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# 32+ random chars each:  openssl rand -base64 48
JWT_SECRET=
SESSION_SECRET=
OTP_PEPPER=
# Single admin login for the admin site. Use ADMIN_PASSWORD_HASH (npm run hash-password) in production.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=            # plain alternative (not recommended)
# Gmail / Workspace SMTP with app passwords. Several accounts = round-robin (JSON array).
SMTP_ACCOUNTS=[{"user":"you@gmail.com","pass":"abcdefghijklmnop"}]
SMTP_DAILY_LIMIT=1900   # per account (450 for free @gmail.com)
MAIL_FROM_NAME=Qiskit Fall Fest
# Public URL of this service (used for admin origin checks)
PUBLIC_URL=https://qff-api-xxxxx.a.run.app
# Event timezone for day boundaries
EVENT_TZ=Asia/Kolkata
